{
  "name": "atlas-mcp",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "Open-source runtime for safe, reliable, and verifiable MCP execution.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@9.5.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "2.0.12"
    }
  },
  "scripts": {
    "build": "pnpm -r build",
    "clean": "pnpm -r clean",
    "dev": "pnpm --filter @atlas-mcp/cli dev",
    "atlas": "pnpm --filter @atlas-mcp/cli start",
    "e2e": "pnpm --filter @atlas-mcp/server test:e2e",
    "docker:smoke": "node scripts/docker-smoke.mjs",
    "evals": "pnpm --filter @atlas-mcp/evals evaluate",
    "python:check": "uv run --project sdk-py ruff check sdk-py && uv run --project sdk-py pytest sdk-py",
    "python:audit": "node scripts/python-audit.mjs",
    "security:audit": "pnpm audit --prod --audit-level moderate && pnpm python:audit",
    "test": "pnpm -r test",
    "typecheck": "pnpm build && pnpm -r typecheck",
    "versions:check": "node scripts/check-versions.mjs",
    "check": "pnpm versions:check && pnpm typecheck && pnpm test && pnpm python:check",
    "pack:check": "pnpm build && pnpm --dir apps/cli pack:check"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/node": "22.15.30",
    "tsx": "4.20.6",
    "typescript": "5.8.3",
    "vitest": "3.2.6"
  }
}
