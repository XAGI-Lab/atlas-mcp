{
  "name": "@melra/file-runtime",
  "version": "0.3.0-alpha.0",
  "description": "Workspace-confined file execution runtime for MELRA.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@melra/protocol": "workspace:*"
  }
}
