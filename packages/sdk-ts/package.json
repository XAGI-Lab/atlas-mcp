{
  "name": "@melra/sdk",
  "version": "0.3.0-alpha.2",
  "description": "TypeScript task and workflow client SDK for MELRA.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
