{
  "name": "@melra/server",
  "version": "0.2.0-alpha.1",
  "description": "Official six-tool Model Context Protocol server for MELRA.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:e2e": "vitest run test/e2e.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@melra/browser-runtime": "workspace:*",
    "@melra/computer-runtime": "workspace:*",
    "@melra/file-runtime": "workspace:*",
    "@melra/memory": "workspace:*",
    "@melra/policy-core": "workspace:*",
    "@melra/protocol": "workspace:*",
    "@melra/receipt-schema": "workspace:*",
    "@melra/runtime-core": "workspace:*",
    "@melra/storage-sqlite": "workspace:*",
    "@melra/terminal-runtime": "workspace:*",
    "@melra/verifier-core": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "3.25.76"
  }
}
