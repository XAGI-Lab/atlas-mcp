{
  "name": "@melra/storage-sqlite",
  "version": "0.3.0-alpha.2",
  "description": "Transactional SQLite task, workflow, event, payload, and evidence storage for MELRA.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "vitest run --no-file-parallelism --testTimeout=30000",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@melra/protocol": "workspace:*",
    "@melra/receipt-schema": "workspace:*"
  }
}
